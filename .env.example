# STAR Trading Scanner - Environment Configuration

# Dhan API Configuration
DHAN_API_KEY=your_dhan_api_key_here
DHAN_CLIENT_ID=your_dhan_client_id_here

# Database Configuration
DB_PATH=./data/scanner.db

# Session Configuration
SESSION_START_TIME=09:15
SESSION_END_TIME=15:30

# Defaults and Thresholds
PRICE_NOISE_THRESHOLD=0.0001
VOLUME_RANK_STRONG=100
VOLUME_RANK_MODERATE=250
VOLUME_RANK_WARNING=300
OI_STRENGTH_WEAK=1.0
OI_STRENGTH_MEDIUM_LOW=1.4
OI_STRENGTH_STRONG=1.4
BASELINE_LOOKBACK_SESSIONS=5
NEUTRAL_BAND=0.0

# Trading Symbols - NSE F&O stocks (sample)
UNIVERSE_SYMBOLS=RELIANCE,TCS,INFY,HDFC,ICICIBANK,AXISBANK,LT,WIPRO,MARUTI,BAJAJFINSV,SBILIFE,SUNPHARMA,INDIGO,APOLLOHOSP,ONGC,COALINDIA,BHARTIARTL,POWERGRID,JSWSTEEL,TATASTEEL

# API Rate Limiting
API_TIMEOUT_SECONDS=10
API_RETRY_COUNT=3
API_RETRY_DELAY_SECONDS=2
MAX_CONCURRENT_SYMBOLS=5

# Data Quality
MIN_OPTIONS_COVERAGE_PERCENT=80

# Logging
LOG_LEVEL=INFO
LOG_PATH=./logs

# Feature Flags
PAPER_MODE=false
ENABLE_HISTORICAL_REPLAY=false
